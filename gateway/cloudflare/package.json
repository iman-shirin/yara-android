{
  "name": "yara-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply yara-db --local",
    "db:remote": "wrangler d1 migrations apply yara-db --remote",
    "check": "node --check src/index.mjs && node --check src/security.mjs && node --check src/collaboration.mjs && node --check ../shared/permissions.mjs && node --check ../shared/rate-limit.mjs",
    "test": "node --test test/security-and-validation.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
