# Never commit a populated .env file or private key.
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://yara_gateway:CHANGE_ME@postgres:5432/yara_gateway
PGSSLMODE=require
PG_POOL_MAX=10

# One-time owner bootstrap secret (minimum 32 characters); rotate after provisioning.
YARA_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET

# Dedicated GitHub App installed only on the YARA repository.
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_INSTALLATION_ID=REPLACE_WITH_INSTALLATION_ID
# Base64-encoded PEM private key, injected by the deployment secret manager.
GITHUB_APP_PRIVATE_KEY_BASE64=INJECT_FROM_SECRET_MANAGER
